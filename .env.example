# Discord application credentials (Developer Portal → General Information / Bot)
DISCORD_TOKEN=your_bot_token
CLIENT_ID=your_application_id

# Optional: instant slash-command overrides for one or more test servers.
# Global commands are ALWAYS registered (they work in every server, but Discord may cache up to an hour).
# Comma-separate several server IDs; leave empty for global-only registration.
DEV_GUILD_ID=

# Logging and runtime
LOG_LEVEL=debug
NODE_ENV=development
