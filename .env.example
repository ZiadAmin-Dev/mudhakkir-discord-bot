# Discord application credentials (Developer Portal → General Information / Bot)
DISCORD_TOKEN=your_bot_token
CLIENT_ID=1574601678626226227

# Optional: instant slash-command overrides for one or more test servers.
# Global commands are ALWAYS registered (they work in every server, but Discord may cache up to an hour).
# Comma-separate several server IDs; leave empty for global-only registration.
DEV_GUILD_ID=1494705625702207552

# Optional: full path to the SQLite database file. Leave blank for data/mudhakkir.db.
# On hosts with persistent storage outside the app directory, point this at that path.
DB_PATH=

# Logging and runtime
LOG_LEVEL=debug
NODE_ENV=development

# Optional: how long shutdown waits for in-flight announcements (milliseconds)
SHUTDOWN_GRACE_MS=10000
